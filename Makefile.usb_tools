# USB速度检测工具 Makefile
# Debian/Ubuntu安装依赖: sudo apt-get install libglib2.0-dev libudev-dev

CC = gcc
CFLAGS = `pkg-config --cflags glib-2.0 libudev`
LIBS = `pkg-config --libs glib-2.0 libudev`

all: usb_speed_detector usb_monitor usb_info_simple

usb_speed_detector: usb_speed_detector.c
	$(CC) -o usb_speed_detector usb_speed_detector.c $(CFLAGS) $(LIBS)
	@echo "✅ 已编译: usb_speed_detector"

usb_monitor: usb_monitor.c
	$(CC) -o usb_monitor usb_monitor.c $(CFLAGS) $(LIBS)
	@echo "✅ 已编译: usb_monitor"

usb_info_simple: usb_info_simple.c
	$(CC) -o usb_info_simple usb_info_simple.c $(CFLAGS) $(LIBS)
	@echo "✅ 已编译: usb_info_simple"

clean:
	rm -f usb_speed_detector usb_monitor usb_info_simple
	@echo "🧹 已清理编译文件"

install:
	@echo "安装依赖包..."
	sudo apt-get install -y libglib2.0-dev libudev-dev

help:
	@echo "USB速度检测工具 - 编译帮助"
	@echo ""
	@echo "使用方法:"
	@echo "  make install    - 安装编译依赖"
	@echo "  make            - 编译所有工具"
	@echo "  make clean      - 清理编译文件"
	@echo ""
	@echo "编译后的工具:"
	@echo "  usb_speed_detector - 检测指定U盘的速度（需要root）"
	@echo "  usb_monitor        - 监听U盘插入并显示速度"
	@echo "  usb_info_simple    - 查看USB协议速度（无需root）"

.PHONY: all clean install help
